; Engine configuration file.
; Minimal Hueman shell that reads Hollow Grove bridge artifacts.

config_version=5

[application]

config/name="Hueman Screen Shell"
run/main_scene="res://scenes/hueman_screen_shell.tscn"

[display]

window/size/viewport_width=3840
window/size/viewport_height=2160
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
