pkgname=hueman
pkgver=0.1.0
pkgrel=1
pkgdesc='Independent Godot presentation client for Hollow Grove'
arch=('any')
url='https://github.com/RoiLenox/hollow_grove'
license=('LicenseRef-Hollow-Grove-Proprietary')
options=('!debug')
depends=('godot>=4.7')
makedepends=('python')
optdepends=('hollow-grove-core: authoritative gameplay service')
source=()
sha256sums=()

build() {
    local repository_root="$startdir/../.."
    cd "$repository_root"
    godot --headless --path hueman_godot \
        --export-pack Linux "$srcdir/hueman.pck"
}

check() {
    local repository_root="$startdir/../.."
    cd "$repository_root"
    ./verify-art-assets.sh
    godot --headless --path hueman_godot \
        --script res://tests/runtime_client_smoke.gd
    godot --headless --path hueman_godot \
        --script res://tests/retro_overworld_semantics_smoke.gd
}

package() {
    local repository_root="$startdir/../.."
    install -Dm755 "$startdir/launch" "$pkgdir/usr/lib/hueman/launch"
    install -Dm755 "$startdir/hueman" "$pkgdir/usr/bin/hueman"
    install -Dm644 "$srcdir/hueman.pck" "$pkgdir/usr/share/hueman/hueman.pck"
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$repository_root/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
