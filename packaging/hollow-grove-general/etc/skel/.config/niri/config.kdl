// Hollow Grove General Edition
// Hardware-neutral Niri profile for new users.

prefer-no-csd
screenshot-path "~/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"

// Immediate feedback is part of the General Edition latency profile.
animations { off; }

cursor {
  xcursor-theme "Adwaita"
  xcursor-size 28
}

input {
  keyboard {
    xkb { }
    repeat-delay 300
    repeat-rate 35
  }

  touchpad {
    tap
    drag true
    drag-lock
    natural-scroll
    tap-button-map "left-right-middle"
    click-method "clickfinger"
    accel-speed 0.2
    accel-profile "flat"
    scroll-method "two-finger"
  }
}

// No output block belongs in the General Edition. Niri selects attached
// displays automatically. Post-install tooling may add a machine-local file.

layout {
  gaps 0

  struts {
    left 0
    right 0
    top 0
    bottom 0
  }

  focus-ring { off; }
  border { off; }
  shadow { off; }

  default-column-width { proportion 0.25; }

  preset-column-widths {
    proportion 0.25
    proportion 0.33
    proportion 0.50
    proportion 0.66
    proportion 0.75
    proportion 1.00
  }

  preset-window-heights {
    proportion 0.15
    proportion 0.25
    proportion 0.33
    proportion 0.50
    proportion 0.66
    proportion 0.75
    proportion 0.85
    proportion 1.00
  }
}

window-rule {
  open-floating false
  geometry-corner-radius 0
  clip-to-geometry true
}

window-rule {
  match app-id=r#"(^walker$|^z\.walker$|[.]walker$|^anyrun$)"#
  default-column-width { proportion 0.25; }
}

window-rule {
  match app-id=r#"^org\.kde\.audiotube$"#
  default-column-width { proportion 0.33333; }
  geometry-corner-radius 14
  clip-to-geometry true
}

window-rule {
  match app-id=r#"^river$"# title=r#"^river - WL-[0-9]+$"#
  default-column-width { proportion 0.25; }
  opacity 1.0
}

environment {
  MOZ_ENABLE_WAYLAND "1"
  GDK_BACKEND "wayland,x11,*"
  QT_QPA_PLATFORM "wayland;xcb"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
}

spawn-at-startup "/usr/lib/hollow-grove/bin/session-environment"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-optional-service" "hollow-niri.service"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-optional-service" "mako.service"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-optional-service" "elephant.service"
spawn-at-startup "/usr/bin/hollow-launch" "--label" "PolicyKit authentication agent" "--require" "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" "--" "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-wallpaper"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-shell"
spawn-at-startup "/usr/lib/hollow-grove/bin/clipboard-watch"

binds {
  // Hollow Grove Keyboard Constitution v1
  //
  // KEY = WHAT · MODIFIER = HOW
  //
  // Super       = Primary   = Normal way
  // Super+Shift = Adjacent  = Different form
  // Super+Ctrl  = Focused   = Specialized/control
  // Super+Alt   = Alternate = Other way
  //
  // A/B/C/D/E/F/G = AI/Browse/Code/Downloads/Email/Files/Games
  // H/J/K/L = left/down/up/right Movement
  // I/M/N/O/P/Q/R = Inspect/Music/Network/Office/Photos/Query/Record
  // S/T/U/V/W/X/Y/Z = Settings/Time/Utilities/Videos/Wrappers/eXecute/sYnc/Zip
  //
  // Memory hooks: A Artificial intelligence; B Web; C Source code; D Acquire files; E Mail;
  // F Filesystem; G PLAY; H Flynt; I Look inside; J Glaüshouse;
  // K Stonebend; L Sandmanor; M HEAR; N Connections; O Productivity;
  // P Photography; Q Find information; R Capture; S Configure; T Clock and timing;
  // U System tools; V WATCH; W Windows compatibility; X Run commands and workflows;
  // Y Folder/device sync; Z Archives.

  // Stonebend / Escape: exit and session boundary.
  Mod+Escape                 { close-window; }
  Mod+Shift+Escape           { spawn "/usr/lib/hollow-grove/bin/lock-session"; }
  Mod+Ctrl+Escape            { quit; }
  Mod+Alt+Escape             { spawn "/usr/bin/hollow-launch" "--label" "Nested River close" "--require" "river-scope-close" "--" "river-scope-close"; }
  Mod+Ctrl+Alt+Escape        { spawn "systemctl" "reboot"; }
  Mod+Ctrl+Alt+Shift+Escape  { spawn "systemctl" "poweroff"; }

  // Sandmanor / Return: entering threshold, terminal, and Hueman transport.
  Mod+Return            { spawn "kitty"; }
  Mod+Shift+Return      { spawn "/usr/bin/hollow-launch" "--label" "Zellij terminal" "--require" "kitty" "--require" "zellij" "--" "kitty" "zellij"; }
  Mod+Ctrl+Return       { spawn "kitty" "bash"; }
  Mod+Alt+Return        { spawn "/usr/bin/hollow-hueman" "launch"; }
  Mod+Alt+Ctrl+Return   { spawn "/usr/bin/hollow-hueman" "rebind"; }
  Mod+Alt+Shift+Return  { spawn "/usr/bin/hollow-launch" "--label" "Nested River terminal scope" "--require" "river-scope-spawn" "--require" "river-kitty" "--" "river-scope-spawn" "river-kitty"; }
  Mod+Alt+KP_Enter      { spawn "/usr/bin/hollow-hueman" "launch"; }
  Mod+Alt+Slash         { spawn "/usr/bin/hollow-launch" "--label" "Nested River Hollow Grove probe" "--require" "river-scope-probe" "--" "river-scope-probe"; }

  // Flynt / Grave: Walker's exclusive operating-system entrance.
  Mod+Grave repeat=false hotkey-overlay-title="Flynt: Open Launcher (Walker)" { spawn "/usr/lib/hollow-grove/bin/walker-toggle-niri"; }

  // A — AI / Artificial Intelligence
  // Primary: Codex; Adjacent: OpenCode; Focused: local model control; Alternate: Hollow Grove work in progress.
  Mod+a repeat=false hotkey-overlay-title="AI · Primary: Codex" { spawn "/usr/bin/hollow-launch" "--label" "Codex" "--require" "kitty" "--require" "codex" "--" "kitty" "codex"; }
  Mod+Shift+a repeat=false hotkey-overlay-title="AI · Adjacent: OpenCode" { spawn "/usr/bin/hollow-launch" "--label" "OpenCode" "--require" "kitty" "--require" "opencode" "--" "kitty" "opencode"; }
  Mod+Ctrl+a repeat=false hotkey-overlay-title="AI · Focused: AI Tools and Local Models" { spawn "/usr/bin/hollow-launch" "--label" "AI Tools and Local Models" "--require" "kitty" "--require" "python3" "--" "kitty" "--hold" "/usr/bin/hollow-ai" "chooser"; }
  Mod+Alt+a repeat=false hotkey-overlay-title="AI · Alternate: Alternate Local Chat" { spawn "/usr/bin/hollow-launch" "--label" "Alternate Local Chat" "--require" "kitty" "--require" "python3" "--require" "ollama" "--" "kitty" "--hold" "/usr/bin/hollow-ai" "alternate"; }

  // B — Browse
  Mod+b hotkey-overlay-title="Browse · Primary: Firefox" { spawn "/usr/bin/hollow-launch" "--label" "Firefox" "--require" "firefox" "--" "firefox"; }
  Mod+Shift+b hotkey-overlay-title="Browse · Adjacent: Chromium" { spawn "/usr/bin/hollow-launch" "--label" "Chromium" "--require" "chromium" "--" "chromium"; }
  Mod+Ctrl+b hotkey-overlay-title="Browse · Focused: Vivaldi" { spawn "/usr/bin/hollow-launch" "--label" "Vivaldi" "--require" "vivaldi-stable" "--" "vivaldi-stable"; }
  Mod+Alt+b hotkey-overlay-title="Browse · Alternate: Brave" { spawn "/usr/bin/hollow-launch" "--label" "Brave" "--require" "brave" "--" "brave"; }

  // C — Code / Manual Coding
  // Primary: Helix; Adjacent: Lapce; Focused: Zed. Coding agents belong to A.
  Mod+c repeat=false hotkey-overlay-title="Code · Primary: Helix" { spawn "/usr/bin/hollow-launch" "--label" "Helix" "--require" "kitty" "--require" "helix" "--" "kitty" "helix"; }
  Mod+Shift+c repeat=false hotkey-overlay-title="Code · Adjacent: Lapce" { spawn "/usr/bin/hollow-launch" "--label" "Lapce" "--require" "lapce" "--" "lapce"; }
  Mod+Ctrl+c repeat=false hotkey-overlay-title="Code · Focused: Zed" { spawn "/usr/bin/hollow-launch" "--label" "Zed" "--require" "zeditor" "--" "zeditor"; }
  // Mod+Alt+c — Alternate: reserved for another manual coding workflow.

  // D — Downloads
  // Primary: graphical torrents; Adjacent: terminal torrents.
  Mod+d repeat=false hotkey-overlay-title="Downloads · Primary: qBittorrent" { spawn "/usr/bin/hollow-launch" "--label" "qBittorrent" "--require" "qbittorrent" "--" "qbittorrent"; }
  Mod+Shift+d repeat=false hotkey-overlay-title="Downloads · Adjacent: rTorrent" { spawn "/usr/bin/hollow-launch" "--label" "rTorrent" "--require" "kitty" "--require" "rtorrent" "--" "kitty" "rtorrent"; }
  // Mod+Ctrl+d — Focused: reserved for distinct download queue/transfer control.
  // Mod+Alt+d — Alternate: reserved for another download method.

  // E — Email
  // Primary: graphical email; Adjacent: terminal email; Focused: account inspection.
  Mod+e repeat=false hotkey-overlay-title="Email · Primary: Thunderbird" { spawn "/usr/bin/hollow-launch" "--label" "Thunderbird" "--require" "thunderbird" "--" "thunderbird"; }
  Mod+Shift+e repeat=false hotkey-overlay-title="Email · Adjacent: Himalaya" { spawn "/usr/bin/hollow-launch" "--label" "Himalaya" "--require" "kitty" "--require" "himalaya" "--" "kitty" "--hold" "himalaya"; }
  Mod+Ctrl+e repeat=false hotkey-overlay-title="Email · Focused: Email Accounts" { spawn "/usr/bin/hollow-launch" "--label" "Email Accounts" "--require" "kitty" "--require" "himalaya" "--" "kitty" "--hold" "himalaya" "account" "list"; }
  // Mod+Alt+e — Alternate: reserved for another email client/service.

  // F — Files
  Mod+f hotkey-overlay-title="Files · Primary: Yazi" { spawn "/usr/bin/hollow-launch" "--label" "Yazi" "--require" "kitty" "--require" "yazi" "--" "kitty" "yazi"; }
  Mod+Shift+f repeat=false hotkey-overlay-title="Files · Adjacent: Nautilus" { spawn "/usr/bin/hollow-launch" "--label" "Nautilus" "--require" "nautilus" "--" "nautilus"; }
  Mod+Ctrl+f hotkey-overlay-title="Files · Focused: Dolphin" { spawn "/usr/bin/hollow-launch" "--label" "Dolphin file manager" "--require" "dolphin" "--" "dolphin"; }
  Mod+Alt+f hotkey-overlay-title="Files · Alternate: PCManFM-Qt" { spawn "/usr/bin/hollow-launch" "--label" "PCManFM-Qt" "--require" "pcmanfm-qt" "--" "pcmanfm-qt"; }

  // G — Games
  Mod+g hotkey-overlay-title="Games · Primary: Steam" { spawn "/usr/bin/hollow-launch" "--label" "Steam" "--require" "steam" "--" "steam"; }
  Mod+Shift+g hotkey-overlay-title="Games · Adjacent: RPCS3" { spawn "/usr/bin/hollow-launch" "--label" "RPCS3" "--require" "rpcs3" "--" "rpcs3"; }
  Mod+Ctrl+g hotkey-overlay-title="Games · Focused: Dolphin Emulator" { spawn "/usr/bin/hollow-launch" "--label" "Dolphin Emulator" "--require" "dolphin-emu" "--" "dolphin-emu"; }
  Mod+Alt+g hotkey-overlay-title="Games · Alternate: RetroArch" { spawn "/usr/bin/hollow-launch" "--label" "RetroArch" "--require" "retroarch" "--" "retroarch"; }

  // H — ← Movement — Flynt
  // J — ↓ Movement — Glaüshouse
  // K — ↑ Movement — Stonebend
  // L — → Movement — Sandmanor
  // Plain h/j/k/l remain in the app.
  // Right hand: focus.
  Mod+h { focus-column-left; }
  Mod+l { focus-column-right; }
  Mod+j { focus-window-or-workspace-down; }
  Mod+k { focus-window-or-workspace-up; }

  // Right hand: move.
  Mod+Shift+h { move-column-left; }
  Mod+Shift+l { move-column-right; }
  Mod+Shift+j { move-window-down-or-to-workspace-down; }
  Mod+Shift+k { move-window-up-or-to-workspace-up; }

  // Right hand: reshape. J/K cycle the shared quarter-height ladder while
  // preserving their down/up anchoring.
  Mod+Ctrl+h { consume-or-expel-window-left; }
  Mod+Ctrl+j repeat=false hotkey-overlay-title="Layout · Grow Down · 25/50/75/100%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "down"; }
  Mod+Ctrl+k repeat=false hotkey-overlay-title="Layout · Grow Up · 25/50/75/100%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "up"; }
  Mod+Ctrl+l { consume-or-expel-window-right; }

  // Join the adjacent column at an explicit corner; never leave a solo column behind.
  Mod+Ctrl+Shift+h { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "left-top"; }
  Mod+Ctrl+Shift+j { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "left-bottom"; }
  Mod+Ctrl+Shift+k { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "right-top"; }
  Mod+Ctrl+Shift+l { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "right-bottom"; }

  // Direct access to the same downward-anchored 25/50/75/100 ladder that
  // Space cycles through below: H/J/K/L select the four stages in order.
  Mod+Alt+Shift+h repeat=false hotkey-overlay-title="Layout · Direct Height: 25%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "25%"; }
  Mod+Alt+Shift+j repeat=false hotkey-overlay-title="Layout · Direct Height: 50%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "50%"; }
  Mod+Alt+Shift+k repeat=false hotkey-overlay-title="Layout · Direct Height: 75%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "75%"; }
  Mod+Alt+Shift+l repeat=false hotkey-overlay-title="Layout · Direct Height: 100%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "100%"; }

  // Hueman column transport.
  Mod+Alt+Ctrl+h { move-column-left; }
  Mod+Alt+Ctrl+j { move-column-to-workspace-down; }
  Mod+Alt+Ctrl+k { move-column-to-workspace-up; }
  Mod+Alt+Ctrl+l { move-column-right; }

  Mod+BracketLeft             { focus-column-left-or-last; }
  Mod+BracketRight            { focus-column-right-or-first; }
  Mod+Shift+BracketLeft       { move-column-to-first; }
  Mod+Shift+BracketRight      { move-column-to-last; }
  Mod+Ctrl+BracketLeft        { focus-column-first; }
  Mod+Ctrl+BracketRight       { focus-column-last; }

  Mod+Comma        { consume-window-into-column; }
  Mod+Period       { expel-window-from-column; }
  Mod+Shift+Comma { spawn "/usr/bin/hollow-launch" "--label" "Media previous" "--require" "playerctl" "--" "/usr/bin/hollow-media" "previous"; }
  Mod+Shift+Period { spawn "/usr/bin/hollow-launch" "--label" "Media next" "--require" "playerctl" "--" "/usr/bin/hollow-media" "next"; }
  Mod+Alt+Comma    { center-column; }
  Mod+Alt+Period   { center-visible-columns; }

  Mod+Semicolon       { switch-focus-between-floating-and-tiling; }
  Mod+Shift+Semicolon { toggle-window-floating; }
  Mod+Ctrl+Semicolon  { focus-tiling; }
  Mod+Alt+Semicolon   { focus-floating; }

  // Change scope.
  Mod+Alt+Left  { focus-monitor-left; }
  Mod+Alt+Right { focus-monitor-right; }
  Mod+Alt+Down  { focus-workspace-down; }
  Mod+Alt+Up    { focus-workspace-up; }
  Mod+Alt+Ctrl+Shift+h { move-column-to-monitor-left; }
  Mod+Alt+Ctrl+Shift+j { move-column-to-workspace-down; }
  Mod+Alt+Ctrl+Shift+k { move-column-to-workspace-up; }
  Mod+Alt+Ctrl+Shift+l { move-column-to-monitor-right; }

  // Workspaces: focus.
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+0 { focus-workspace 10; }

  // Workspaces: send window and stay.
  Mod+Shift+1 { move-window-to-workspace 1 focus=false; }
  Mod+Shift+2 { move-window-to-workspace 2 focus=false; }
  Mod+Shift+3 { move-window-to-workspace 3 focus=false; }
  Mod+Shift+4 { move-window-to-workspace 4 focus=false; }
  Mod+Shift+5 { move-window-to-workspace 5 focus=false; }
  Mod+Shift+6 { move-window-to-workspace 6 focus=false; }
  Mod+Shift+7 { move-window-to-workspace 7 focus=false; }
  Mod+Shift+8 { move-window-to-workspace 8 focus=false; }
  Mod+Shift+9 { move-window-to-workspace 9 focus=false; }
  Mod+Shift+0 { move-window-to-workspace 10 focus=false; }

  // Workspaces: send column and stay.
  Mod+Ctrl+1 { move-column-to-workspace 1 focus=false; }
  Mod+Ctrl+2 { move-column-to-workspace 2 focus=false; }
  Mod+Ctrl+3 { move-column-to-workspace 3 focus=false; }
  Mod+Ctrl+4 { move-column-to-workspace 4 focus=false; }
  Mod+Ctrl+5 { move-column-to-workspace 5 focus=false; }
  Mod+Ctrl+6 { move-column-to-workspace 6 focus=false; }
  Mod+Ctrl+7 { move-column-to-workspace 7 focus=false; }
  Mod+Ctrl+8 { move-column-to-workspace 8 focus=false; }
  Mod+Ctrl+9 { move-column-to-workspace 9 focus=false; }
  Mod+Ctrl+0 { move-column-to-workspace 10 focus=false; }

  // Workspaces: send column and follow.
  Mod+Ctrl+Shift+1 { move-column-to-workspace 1; }
  Mod+Ctrl+Shift+2 { move-column-to-workspace 2; }
  Mod+Ctrl+Shift+3 { move-column-to-workspace 3; }
  Mod+Ctrl+Shift+4 { move-column-to-workspace 4; }
  Mod+Ctrl+Shift+5 { move-column-to-workspace 5; }
  Mod+Ctrl+Shift+6 { move-column-to-workspace 6; }
  Mod+Ctrl+Shift+7 { move-column-to-workspace 7; }
  Mod+Ctrl+Shift+8 { move-column-to-workspace 8; }
  Mod+Ctrl+Shift+9 { move-column-to-workspace 9; }
  Mod+Ctrl+Shift+0 { move-column-to-workspace 10; }

  // I — Inspect
  // Primary: live activity; Adjacent: system snapshot; Focused: hardware health; Alternate: session evidence.
  Mod+i repeat=false hotkey-overlay-title="Inspect · Primary: Live Processes" { spawn "/usr/bin/hollow-launch" "--label" "Live Processes" "--require" "kitty" "--require" "htop" "--" "kitty" "htop"; }
  Mod+Shift+i repeat=false hotkey-overlay-title="Inspect · Adjacent: System Snapshot" { spawn "/usr/bin/hollow-launch" "--label" "System Snapshot" "--require" "kitty" "--require" "fastfetch" "--" "kitty" "--hold" "fastfetch"; }
  Mod+Ctrl+i repeat=false hotkey-overlay-title="Inspect · Focused: Hardware Sensors" { spawn "/usr/bin/hollow-launch" "--label" "Hardware Sensors" "--require" "kitty" "--require" "sensors" "--" "kitty" "--hold" "sensors"; }
  Mod+Alt+i repeat=false hotkey-overlay-title="Inspect · Alternate: Session Logs" { spawn "/usr/bin/hollow-launch" "--label" "Session Logs" "--require" "kitty" "--require" "journalctl" "--" "kitty" "journalctl" "--user" "-b" "-n" "200"; }

  // M — Music
  Mod+m hotkey-overlay-title="Music · Primary: AudioTube" { spawn "/usr/lib/hollow-grove/bin/audiotube-niri"; }
  Mod+Shift+m hotkey-overlay-title="Music · Adjacent: youtui" { spawn "/usr/bin/hollow-launch" "--label" "youtui" "--require" "kitty" "--require" "youtui" "--" "kitty" "youtui"; }
  Mod+Ctrl+m repeat=false hotkey-overlay-title="Music · Focused: Spotify + Spicetify" { spawn "/usr/bin/hollow-launch" "--label" "Spotify + Spicetify" "--require" "spotify-launcher" "--require" "spicetify" "--" "hollow-spotify"; }
  Mod+Alt+m repeat=false hotkey-overlay-title="Music · Alternate: spotify-tui" { spawn "/usr/bin/hollow-launch" "--label" "spotify-tui" "--require" "kitty" "--require" "spt" "--" "kitty" "--hold" "spt"; }

  // N — Network / Connections
  Mod+n repeat=false hotkey-overlay-title="Network · Primary: Connections" { spawn "/usr/bin/hollow-launch" "--label" "Connections" "--require" "kitty" "--require" "nmtui" "--" "kitty" "nmtui"; }
  Mod+Shift+n repeat=false hotkey-overlay-title="Network · Adjacent: Profiles and VPN" { spawn "/usr/bin/hollow-launch" "--label" "Profiles and VPN" "--require" "nm-connection-editor" "--" "nm-connection-editor"; }
  Mod+Ctrl+n repeat=false hotkey-overlay-title="Network · Focused: Connection Diagnostics" { spawn "/usr/bin/hollow-launch" "--label" "Connection Diagnostics" "--require" "kitty" "--require" "nmcli" "--" "kitty" "--hold" "nmcli" "--pretty" "device" "show"; }
  Mod+Alt+n repeat=false hotkey-overlay-title="Network · Alternate: SSH Remote Access" { spawn "/usr/bin/hollow-launch" "--label" "SSH Remote Access" "--require" "kitty" "--require" "ssh" "--" "kitty" "/usr/bin/hollow-network-ssh"; }

  // O — Office
  Mod+o hotkey-overlay-title="Office · Primary: LibreOffice Writer" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Writer" "--require" "libreoffice" "--" "libreoffice" "--writer"; }
  Mod+Shift+o hotkey-overlay-title="Office · Adjacent: LibreOffice Calc" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Calc" "--require" "libreoffice" "--" "libreoffice" "--calc"; }
  Mod+Ctrl+o hotkey-overlay-title="Office · Focused: LibreOffice Impress" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Impress" "--require" "libreoffice" "--" "libreoffice" "--impress"; }
  Mod+Alt+o hotkey-overlay-title="Office · Alternate: LibreOffice Draw" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Draw" "--require" "libreoffice" "--" "libreoffice" "--draw"; }

  // P — Photos / Photography
  // Primary: view; Adjacent: organize; Focused: develop and edit.
  Mod+p repeat=false hotkey-overlay-title="Photos · Primary: imv" { spawn "/usr/bin/hollow-launch" "--label" "imv" "--require" "imv" "--" "imv"; }
  Mod+Shift+p repeat=false hotkey-overlay-title="Photos · Adjacent: digiKam" { spawn "/usr/bin/hollow-launch" "--label" "digiKam" "--require" "digikam" "--" "digikam"; }
  Mod+Ctrl+p repeat=false hotkey-overlay-title="Photos · Focused: darktable" { spawn "/usr/bin/hollow-launch" "--label" "darktable" "--require" "darktable" "--" "darktable"; }
  // Mod+Alt+p — Alternate: reserved for another distinct photo workflow.

  // Q — Query / Find information
  // Names / contents / manuals; Grave remains application and window navigation.
  Mod+q repeat=false hotkey-overlay-title="Query · Primary: Find Files" { spawn "/usr/bin/hollow-launch" "--label" "Find Files" "--require" "kitty" "--require" "python3" "--require" "fzf" "--require" "rg" "--require" "bat" "--require" "xdg-open" "--" "kitty" "--hold" "/usr/bin/hollow-query" "files"; }
  Mod+Shift+q repeat=false hotkey-overlay-title="Query · Adjacent: Search Contents" { spawn "/usr/bin/hollow-launch" "--label" "Search Contents" "--require" "kitty" "--require" "python3" "--require" "fzf" "--require" "rg" "--require" "bat" "--require" "less" "--" "kitty" "--hold" "/usr/bin/hollow-query" "text"; }
  Mod+Ctrl+q repeat=false hotkey-overlay-title="Query · Focused: System Manuals" { spawn "/usr/bin/hollow-launch" "--label" "System Manuals" "--require" "kitty" "--require" "python3" "--require" "fzf" "--require" "rg" "--require" "bat" "--require" "man" "--require" "apropos" "--" "kitty" "--hold" "/usr/bin/hollow-query" "manuals"; }
  // Mod+Alt+q — Alternate: reserved for another distinct search workflow.

  // R — Record
  Mod+r hotkey-overlay-title="Record · Primary: Waveform" { spawn "/usr/bin/hollow-launch" "--label" "Tracktion Waveform" "--require" "Waveform13" "--" "Waveform13"; }
  Mod+Shift+r hotkey-overlay-title="Record · Adjacent: Ardour" { spawn "/usr/lib/hollow-grove/bin/ardour-niri"; }
  Mod+Ctrl+r hotkey-overlay-title="Record · Focused: Audacity" { spawn "/usr/bin/hollow-launch" "--label" "Audacity" "--require" "audacity" "--" "audacity"; }
  Mod+Alt+r hotkey-overlay-title="Record · Alternate: REAPER" { spawn "/usr/bin/hollow-launch" "--label" "REAPER" "--require" "reaper" "--" "reaper"; }

  // S — Settings
  Mod+s repeat=false hotkey-overlay-title="Settings · Primary: niri Configuration" { spawn "/usr/bin/hollow-launch" "--label" "niri Configuration" "--require" "kitty" "--require" "helix" "--" "kitty" "sh" "-c" "exec helix \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl\""; }
  Mod+Shift+s hotkey-overlay-title="Settings · Adjacent: Blueman Manager" { spawn "/usr/bin/hollow-launch" "--label" "Blueman Manager" "--require" "blueman-manager" "--" "blueman-manager"; }
  // Mod+Ctrl+s — Focused: network controls moved to N; reserved until Settings review.
  Mod+Alt+s hotkey-overlay-title="Settings · Alternate: PipeWire Volume" { spawn "/usr/bin/hollow-launch" "--label" "PipeWire Volume" "--require" "pwvucontrol" "--" "pwvucontrol"; }

  // T — Time / Clock and timing
  Mod+t repeat=false hotkey-overlay-title="Time · Primary: Large Clock" { spawn "/usr/bin/hollow-launch" "--label" "Time Clock" "--require" "kitty" "--require" "peaclock" "--" "kitty" "--title" "Time · Clock" "sh" "-c" "exec peaclock --config \"${XDG_CONFIG_HOME:-$HOME/.config}/hollow-grove/time/clock.conf\""; }
  Mod+Shift+t repeat=false hotkey-overlay-title="Time · Adjacent: GNOME Clocks" { spawn "/usr/bin/hollow-launch" "--label" "GNOME Clocks" "--require" "gnome-clocks" "--" "gnome-clocks"; }
  Mod+Ctrl+t repeat=false hotkey-overlay-title="Time · Focused: Timers and Stopwatch" { spawn "/usr/bin/hollow-launch" "--label" "Timers and Stopwatch" "--require" "kitty" "--require" "python3" "--" "kitty" "--hold" "/usr/bin/hollow-time"; }
  Mod+Alt+t repeat=false hotkey-overlay-title="Time · Alternate: Retro Clock" { spawn "/usr/bin/hollow-launch" "--label" "Retro Clock" "--require" "kitty" "--require" "tty-clock" "--" "kitty" "--title" "Time · Retro Clock" "tty-clock" "-r" "-s" "-b" "-B"; }

  // U — Utilities
  Mod+u hotkey-overlay-title="Utilities · Primary: btop" { spawn "/usr/bin/hollow-launch" "--label" "btop" "--require" "kitty" "--require" "btop" "--" "kitty" "btop"; }
  Mod+Shift+u hotkey-overlay-title="Utilities · Adjacent: ncdu" { spawn "/usr/bin/hollow-launch" "--label" "ncdu" "--require" "kitty" "--require" "ncdu" "--" "kitty" "ncdu"; }
  Mod+Ctrl+u hotkey-overlay-title="Utilities · Focused: nvtop" { spawn "/usr/bin/hollow-launch" "--label" "nvtop" "--require" "kitty" "--require" "nvtop" "--" "kitty" "nvtop"; }
  Mod+Alt+u hotkey-overlay-title="Utilities · Alternate: battop" { spawn "/usr/bin/hollow-launch" "--label" "battop" "--require" "kitty" "--require" "battop" "--" "kitty" "battop"; }

  // V — Videos / WATCH
  // Library / collection folders / local-file playback / online alternative.
  Mod+v repeat=false hotkey-overlay-title="Videos · Primary: Local Movie Library" { spawn "/usr/bin/hollow-launch" "--label" "Local Movie Library" "--require" "python3" "--require" "kodi" "--" "/usr/bin/hollow-video" "library"; }
  Mod+Shift+v repeat=false hotkey-overlay-title="Videos · Adjacent: Collection Folders" { spawn "/usr/bin/hollow-launch" "--label" "Collection Folders" "--require" "python3" "--require" "xdg-open" "--" "/usr/bin/hollow-video" "folders"; }
  Mod+Ctrl+v repeat=false hotkey-overlay-title="Videos · Focused: Play Local Video" { spawn "/usr/bin/hollow-launch" "--label" "Play Local Video" "--require" "python3" "--require" "zenity" "--require" "mpv" "--" "/usr/bin/hollow-video" "play"; }
  Mod+Alt+v repeat=false hotkey-overlay-title="Videos · Alternate: FreeTube" { spawn "/usr/bin/hollow-launch" "--label" "FreeTube" "--require" "freetube" "--" "freetube"; }

  // W — Wrappers / Windows compatibility
  // Hub / run a Windows executable / configure a bottle / Proton repair.
  Mod+w repeat=false hotkey-overlay-title="Wrappers · Primary: Bottles" { spawn "/usr/bin/hollow-launch" "--label" "Bottles" "--require" "python3" "--" "/usr/bin/hollow-wrappers" "hub"; }
  Mod+Shift+w repeat=false hotkey-overlay-title="Wrappers · Adjacent: Run Windows Software" { spawn "/usr/bin/hollow-launch" "--label" "Run Windows Software" "--require" "python3" "--require" "zenity" "--" "/usr/bin/hollow-wrappers" "run"; }
  Mod+Ctrl+w repeat=false hotkey-overlay-title="Wrappers · Focused: Bottle Windows Settings" { spawn "/usr/bin/hollow-launch" "--label" "Bottle Windows Settings" "--require" "python3" "--require" "zenity" "--" "/usr/bin/hollow-wrappers" "configure"; }
  Mod+Alt+w repeat=false hotkey-overlay-title="Wrappers · Alternate: Protontricks" { spawn "/usr/bin/hollow-launch" "--label" "Protontricks" "--require" "python3" "--require" "protontricks" "--" "/usr/bin/hollow-wrappers" "proton"; }

  // X — eXecute / Run commands and workflows
  // Command / executable script / project task; Alt remains reserved.
  Mod+x repeat=false hotkey-overlay-title="eXecute · Primary: Run a Command" { spawn "/usr/bin/hollow-launch" "--label" "Run a Command" "--require" "kitty" "--require" "python3" "--" "kitty" "--hold" "--title" "eXecute · Run a Command" "/usr/bin/hollow-execute" "command"; }
  Mod+Shift+x repeat=false hotkey-overlay-title="eXecute · Adjacent: Run a Script" { spawn "/usr/bin/hollow-launch" "--label" "Run a Script" "--require" "kitty" "--require" "python3" "--require" "fzf" "--" "kitty" "--hold" "--title" "eXecute · Run a Script" "/usr/bin/hollow-execute" "scripts"; }
  Mod+Ctrl+x repeat=false hotkey-overlay-title="eXecute · Focused: Run a Project Task" { spawn "/usr/bin/hollow-launch" "--label" "Run a Project Task" "--require" "kitty" "--require" "python3" "--require" "fzf" "--" "kitty" "--hold" "--title" "eXecute · Run a Project Task" "/usr/bin/hollow-execute" "tasks"; }
  // Mod+Alt+x — Alternate: reserved for a distinct execution method.

  // Y — sYnc / Folder and device synchronization
  Mod+y repeat=false hotkey-overlay-title="sYnc · Primary: Syncthing" { spawn "/usr/bin/hollow-launch" "--label" "Syncthing" "--require" "python3" "--require" "syncthing" "--require" "systemctl" "--require" "xdg-open" "--" "/usr/bin/hollow-sync" "dashboard"; }
  Mod+Shift+y repeat=false hotkey-overlay-title="sYnc · Adjacent: Grsync Folder Sync" { spawn "/usr/bin/hollow-launch" "--label" "Grsync Folder Sync" "--require" "grsync" "--" "grsync"; }
  Mod+Ctrl+y repeat=false hotkey-overlay-title="sYnc · Focused: Sync Status and Controls" { spawn "/usr/bin/hollow-launch" "--label" "Sync Status and Controls" "--require" "kitty" "--require" "python3" "--require" "syncthing" "--require" "systemctl" "--" "kitty" "--hold" "/usr/bin/hollow-sync" "controls"; }
  // Mod+Alt+y — Alternate: reserved for a future cloud-sync workflow.

  // Z — Zip / Archives
  Mod+z repeat=false hotkey-overlay-title="Zip · Primary: Archive Manager" { spawn "/usr/bin/hollow-launch" "--label" "Archive Manager" "--require" "file-roller" "--" "file-roller"; }
  Mod+Shift+z repeat=false hotkey-overlay-title="Zip · Adjacent: Create Archive from Folder" { spawn "/usr/bin/hollow-launch" "--label" "Create Archive from Folder" "--require" "python3" "--require" "zenity" "--require" "file-roller" "--" "/usr/bin/hollow-zip" "create"; }
  Mod+Ctrl+z repeat=false hotkey-overlay-title="Zip · Focused: Extract Archive" { spawn "/usr/bin/hollow-launch" "--label" "Extract Archive" "--require" "python3" "--require" "zenity" "--require" "file-roller" "--" "/usr/bin/hollow-zip" "extract"; }
  Mod+Alt+z repeat=false hotkey-overlay-title="Zip · Alternate: Inspect Archive Contents" { spawn "/usr/bin/hollow-launch" "--label" "Inspect Archive Contents" "--require" "kitty" "--require" "python3" "--require" "zenity" "--require" "bsdtar" "--" "kitty" "--hold" "/usr/bin/hollow-zip" "inspect"; }

  Mod+Tab       { toggle-overview; }
  Mod+Shift+Tab { focus-window-previous; }
  Mod+Ctrl+Tab  { focus-workspace-previous; }
  Mod+Alt+Tab   { focus-monitor-previous; }

  // Glaüshouse / Space: clearance and usable window room. Height flow uses
  // the same four stages exposed directly on Alt+Shift+H/J/K/L.
  Mod+Space hotkey-overlay-title="Glaüshouse: Cycle Usable Room Forward" { switch-preset-column-width; }
  Mod+Shift+Space hotkey-overlay-title="Glaüshouse: Cycle Usable Room Backward" { switch-preset-column-width-back; }
  Mod+Ctrl+Space               { set-column-width "25%"; }
  Mod+Ctrl+Shift+Space repeat=false hotkey-overlay-title="Glaüshouse: Flow Height Up · Next 25/50/75/100% Stage" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "up"; }
  Mod+Alt+Space                { expand-column-to-available-width; }
  Mod+Alt+Ctrl+Space           { toggle-windowed-fullscreen; }
  // Sandmanor / Backspace: returning threshold and revision.
  Mod+Alt+BackSpace            { spawn "/usr/bin/hollow-hueman" "clear"; }
  Mod+Alt+Shift+Space repeat=false hotkey-overlay-title="Glaüshouse: Flow Height Down · Next 25/50/75/100% Stage" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "down"; }
  Mod+Ctrl+Alt+BackSpace       { reset-window-height; }
  Mod+Ctrl+Alt+Shift+Space repeat=false hotkey-overlay-title="Glaüshouse: Focus 75% / Bookmark 25%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-cycle"; }

  Mod+Minus       { set-dynamic-cast-window; }
  Mod+Equal       { set-dynamic-cast-monitor; }
  Mod+Shift+Minus { clear-dynamic-cast-target; }
  Mod+Shift+Equal { spawn "/usr/bin/hollow-launch" "--label" "OBS Studio" "--require" "obs" "--" "obs"; }
  Mod+Ctrl+Minus  { spawn "/usr/lib/hollow-grove/bin/screenshot-copy" "region"; }
  Mod+Ctrl+Equal  { spawn "/usr/lib/hollow-grove/bin/screenshot-copy" "screen"; }

  XF86AudioRaiseVolume allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "raise"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "lower"; }
  XF86AudioMute        allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "mute"; }
  XF86AudioMicMute     allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "mic-mute"; }

  XF86MonBrightnessUp   { spawn "/usr/lib/hollow-grove/bin/brightness-control" "raise"; }
  XF86MonBrightnessDown { spawn "/usr/lib/hollow-grove/bin/brightness-control" "lower"; }

  Print { screenshot; }
}
