// Hollow Grove General Edition
// Hardware-neutral Niri profile for new users.

prefer-no-csd
screenshot-path "~/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"

// Immediate feedback is part of the General Edition latency profile.
animations { off; }

cursor {
  xcursor-theme "Adwaita"
  xcursor-size 28
}

input {
  keyboard {
    xkb { }
    repeat-delay 300
    repeat-rate 35
  }

  touchpad {
    tap
    drag true
    drag-lock
    natural-scroll
    tap-button-map "left-right-middle"
    click-method "clickfinger"
    accel-speed 0.2
    accel-profile "flat"
    scroll-method "two-finger"
  }
}

// No output block belongs in the General Edition. Niri selects attached
// displays automatically. Post-install tooling may add a machine-local file.

layout {
  gaps 0

  struts {
    left 0
    right 0
    top 0
    bottom 0
  }

  focus-ring { off; }
  border { off; }
  shadow { off; }

  default-column-width { proportion 0.25; }

  preset-column-widths {
    proportion 0.25
    proportion 0.33
    proportion 0.50
    proportion 0.66
    proportion 0.75
    proportion 1.00
  }

  preset-window-heights {
    proportion 0.15
    proportion 0.25
    proportion 0.33
    proportion 0.50
    proportion 0.66
    proportion 0.75
    proportion 0.85
    proportion 1.00
  }
}

window-rule {
  open-floating false
  geometry-corner-radius 0
  clip-to-geometry true
}

window-rule {
  match app-id=r#"(^walker$|^z\.walker$|[.]walker$|^anyrun$)"#
  default-column-width { proportion 0.25; }
}

window-rule {
  match app-id=r#"^org\.kde\.audiotube$"#
  default-column-width { proportion 0.33333; }
  geometry-corner-radius 14
  clip-to-geometry true
}

window-rule {
  match app-id=r#"^river$"# title=r#"^river - WL-[0-9]+$"#
  default-column-width { proportion 0.25; }
  opacity 1.0
}

environment {
  MOZ_ENABLE_WAYLAND "1"
  GDK_BACKEND "wayland,x11,*"
  QT_QPA_PLATFORM "wayland;xcb"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
}

spawn-at-startup "/usr/lib/hollow-grove/bin/session-environment"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-optional-service" "hollow-niri.service"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-optional-service" "mako.service"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-optional-service" "elephant.service"
spawn-at-startup "/usr/bin/hollow-launch" "--label" "PolicyKit authentication agent" "--require" "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" "--" "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-wallpaper"
spawn-at-startup "/usr/lib/hollow-grove/bin/start-shell"
spawn-at-startup "/usr/lib/hollow-grove/bin/clipboard-watch"

binds {
  // Hollow Grove Keyboard Constitution v1
  //
  // KEY = WHAT · MODIFIER = HOW
  //
  // Super       = Primary   = Normal way
  // Super+Shift = Adjacent  = Different form
  // Super+Ctrl  = Focused   = Specialized/control
  // Super+Alt   = Alternate = Other way
  //
  // A/B/C/D/E/F/G = Assets/Browse/Chat/Develop/Edit/Files/Games
  // H/J/K/L = left/down/up/right Movement
  // I/M/N/O/P/Q/R = Images/Music/News/Office/Photos/Query/Record
  // S/T/U/V/W/X/Y/Z = Settings/Tasks/Utilities/Video/Write/eXchange/sYnc/Zip
  //
  // Memory hooks: A MAKE; B Web; C Communicate; D Code/build; E Modify;
  // F Filesystem; G PLAY; H Flynt; I View images; J Glaüshouse;
  // K Stonebend; L Sandmanor; M HEAR; N Feeds; O Productivity;
  // P Photography; Q Ask AI/search; R Capture; S Configure; T To-do/work;
  // U System tools; V WATCH; W Compose; X Finance/markets;
  // Y Transfer/sync; Z Archives.

  // Stonebend / Escape: exit and session boundary.
  Mod+Escape                 { close-window; }
  Mod+Shift+Escape           { spawn "/usr/lib/hollow-grove/bin/lock-session"; }
  Mod+Ctrl+Escape            { quit; }
  Mod+Alt+Escape             { spawn "/usr/bin/hollow-launch" "--label" "Nested River close" "--require" "river-scope-close" "--" "river-scope-close"; }
  Mod+Ctrl+Alt+Escape        { spawn "systemctl" "reboot"; }
  Mod+Ctrl+Alt+Shift+Escape  { spawn "systemctl" "poweroff"; }

  // Sandmanor / Return: entering threshold, terminal, and Hueman transport.
  Mod+Return            { spawn "kitty"; }
  Mod+Shift+Return      { spawn "/usr/bin/hollow-launch" "--label" "Zellij terminal" "--require" "kitty" "--require" "zellij" "--" "kitty" "zellij"; }
  Mod+Ctrl+Return       { spawn "kitty" "bash"; }
  Mod+Alt+Return        { spawn "/usr/bin/hollow-hueman" "launch"; }
  Mod+Alt+Ctrl+Return   { spawn "/usr/bin/hollow-hueman" "rebind"; }
  Mod+Alt+Shift+Return  { spawn "/usr/bin/hollow-launch" "--label" "Nested River terminal scope" "--require" "river-scope-spawn" "--require" "river-kitty" "--" "river-scope-spawn" "river-kitty"; }
  Mod+Alt+KP_Enter      { spawn "/usr/bin/hollow-hueman" "launch"; }
  Mod+Alt+Slash         { spawn "/usr/bin/hollow-launch" "--label" "Nested River Hollow Grove probe" "--require" "river-scope-probe" "--" "river-scope-probe"; }

  // Flynt / Grave: Walker's exclusive operating-system entrance.
  Mod+Grave repeat=false hotkey-overlay-title="Flynt: Open Launcher (Walker)" { spawn "/usr/lib/hollow-grove/bin/walker-toggle-niri"; }

  // A — Assets
  Mod+a hotkey-overlay-title="Assets · Primary: Aseprite" { spawn "/usr/bin/hollow-launch" "--label" "Aseprite" "--require" "aseprite" "--" "aseprite"; }
  Mod+Shift+a hotkey-overlay-title="Assets · Adjacent: Blender" { spawn "/usr/bin/hollow-launch" "--label" "Blender" "--require" "blender" "--" "blender"; }
  Mod+Ctrl+a hotkey-overlay-title="Assets · Focused: LMMS" { spawn "/usr/lib/hollow-grove/bin/lmms-niri"; }
  // Mod+Alt+a — Alternate: DaVinci Resolve is not part of the portable base.

  // B — Browse
  Mod+b hotkey-overlay-title="Browse · Primary: Firefox" { spawn "/usr/bin/hollow-launch" "--label" "Firefox" "--require" "firefox" "--" "firefox"; }
  Mod+Shift+b hotkey-overlay-title="Browse · Adjacent: Chromium" { spawn "/usr/bin/hollow-launch" "--label" "Chromium" "--require" "chromium" "--" "chromium"; }
  Mod+Ctrl+b hotkey-overlay-title="Browse · Focused: Vivaldi" { spawn "/usr/bin/hollow-launch" "--label" "Vivaldi" "--require" "vivaldi-stable" "--" "vivaldi-stable"; }
  Mod+Alt+b hotkey-overlay-title="Browse · Alternate: Brave" { spawn "/usr/bin/hollow-launch" "--label" "Brave" "--require" "brave" "--" "brave"; }

  // C — Chat
  Mod+c hotkey-overlay-title="Chat · Primary: Himalaya" { spawn "/usr/bin/hollow-launch" "--label" "Himalaya" "--require" "kitty" "--require" "himalaya" "--" "kitty" "himalaya"; }
  Mod+Shift+c hotkey-overlay-title="Chat · Adjacent: Outlook" { spawn "/usr/bin/hollow-launch" "--label" "Outlook integration" "--require" "hollow-outlook" "--" "hollow-outlook"; }
  Mod+Ctrl+c hotkey-overlay-title="Chat · Focused: Element" { spawn "/usr/bin/hollow-launch" "--label" "Element" "--require" "element-desktop" "--" "element-desktop"; }
  Mod+Alt+c hotkey-overlay-title="Chat · Alternate: Discord" { spawn "/usr/bin/hollow-launch" "--label" "Discord" "--require" "discord" "--" "discord"; }

  // D — Develop
  Mod+d hotkey-overlay-title="Develop · Primary: Codex" { spawn "/usr/bin/hollow-launch" "--label" "Codex CLI" "--require" "kitty" "--require" "codex" "--" "kitty" "codex"; }
  Mod+Shift+d hotkey-overlay-title="Develop · Adjacent: OpenCode" { spawn "/usr/bin/hollow-launch" "--label" "OpenCode" "--require" "kitty" "--require" "opencode" "--" "kitty" "opencode"; }
  Mod+Ctrl+d hotkey-overlay-title="Develop · Focused: Code-OSS" { spawn "/usr/bin/hollow-launch" "--label" "Code-OSS" "--require" "code" "--" "code"; }
  Mod+Alt+d hotkey-overlay-title="Develop · Alternate: Zed" { spawn "/usr/bin/hollow-launch" "--label" "Zed" "--require" "zeditor" "--" "zeditor"; }

  // E — Edit
  Mod+e hotkey-overlay-title="Edit · Primary: Helix" { spawn "/usr/bin/hollow-launch" "--label" "Helix" "--require" "kitty" "--require" "helix" "--" "kitty" "helix"; }
  Mod+Shift+e hotkey-overlay-title="Edit · Adjacent: Lapce" { spawn "/usr/bin/hollow-launch" "--label" "Lapce" "--require" "lapce" "--" "lapce"; }
  Mod+Ctrl+e hotkey-overlay-title="Edit · Focused: Neovim" { spawn "/usr/bin/hollow-launch" "--label" "Neovim" "--require" "kitty" "--require" "nvim" "--" "kitty" "nvim"; }
  Mod+Alt+e hotkey-overlay-title="Edit · Alternate: Micro" { spawn "/usr/bin/hollow-launch" "--label" "Micro" "--require" "kitty" "--require" "micro" "--" "kitty" "micro"; }

  // F — Files
  Mod+f hotkey-overlay-title="Files · Primary: Yazi" { spawn "/usr/bin/hollow-launch" "--label" "Yazi" "--require" "kitty" "--require" "yazi" "--" "kitty" "yazi"; }
  Mod+Shift+f hotkey-overlay-title="Files · Adjacent: Thunar" { spawn "/usr/bin/hollow-launch" "--label" "Thunar" "--require" "thunar" "--" "thunar"; }
  Mod+Ctrl+f hotkey-overlay-title="Files · Focused: Dolphin" { spawn "/usr/bin/hollow-launch" "--label" "Dolphin file manager" "--require" "dolphin" "--" "dolphin"; }
  Mod+Alt+f hotkey-overlay-title="Files · Alternate: PCManFM-Qt" { spawn "/usr/bin/hollow-launch" "--label" "PCManFM-Qt" "--require" "pcmanfm-qt" "--" "pcmanfm-qt"; }

  // G — Games
  Mod+g hotkey-overlay-title="Games · Primary: Steam" { spawn "/usr/bin/hollow-launch" "--label" "Steam" "--require" "steam" "--" "steam"; }
  Mod+Shift+g hotkey-overlay-title="Games · Adjacent: RPCS3" { spawn "/usr/bin/hollow-launch" "--label" "RPCS3" "--require" "rpcs3" "--" "rpcs3"; }
  Mod+Ctrl+g hotkey-overlay-title="Games · Focused: Dolphin Emulator" { spawn "/usr/bin/hollow-launch" "--label" "Dolphin Emulator" "--require" "dolphin-emu" "--" "dolphin-emu"; }
  Mod+Alt+g hotkey-overlay-title="Games · Alternate: RetroArch" { spawn "/usr/bin/hollow-launch" "--label" "RetroArch" "--require" "retroarch" "--" "retroarch"; }

  // H — ← Movement — Flynt
  // J — ↓ Movement — Glaüshouse
  // K — ↑ Movement — Stonebend
  // L — → Movement — Sandmanor
  // Plain h/j/k/l remain in the app.
  // Right hand: focus.
  Mod+h { focus-column-left; }
  Mod+l { focus-column-right; }
  Mod+j { focus-window-or-workspace-down; }
  Mod+k { focus-window-or-workspace-up; }

  // Right hand: move.
  Mod+Shift+h { move-column-left; }
  Mod+Shift+l { move-column-right; }
  Mod+Shift+j { move-window-down-or-to-workspace-down; }
  Mod+Shift+k { move-window-up-or-to-workspace-up; }

  // Right hand: reshape. J/K cycle the shared quarter-height ladder while
  // preserving their down/up anchoring.
  Mod+Ctrl+h { consume-or-expel-window-left; }
  Mod+Ctrl+j repeat=false hotkey-overlay-title="Layout · Grow Down · 25/50/75/100%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "down"; }
  Mod+Ctrl+k repeat=false hotkey-overlay-title="Layout · Grow Up · 25/50/75/100%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "up"; }
  Mod+Ctrl+l { consume-or-expel-window-right; }

  // Join the adjacent column at an explicit corner; never leave a solo column behind.
  Mod+Ctrl+Shift+h { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "left-top"; }
  Mod+Ctrl+Shift+j { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "left-bottom"; }
  Mod+Ctrl+Shift+k { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "right-top"; }
  Mod+Ctrl+Shift+l { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "right-bottom"; }

  // Direct access to the same downward-anchored 25/50/75/100 ladder that
  // Space cycles through below: H/J/K/L select the four stages in order.
  Mod+Alt+Shift+h repeat=false hotkey-overlay-title="Layout · Direct Height: 25%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "25%"; }
  Mod+Alt+Shift+j repeat=false hotkey-overlay-title="Layout · Direct Height: 50%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "50%"; }
  Mod+Alt+Shift+k repeat=false hotkey-overlay-title="Layout · Direct Height: 75%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "75%"; }
  Mod+Alt+Shift+l repeat=false hotkey-overlay-title="Layout · Direct Height: 100%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "move" "bottom" "100%"; }

  // Hueman column transport.
  Mod+Alt+Ctrl+h { move-column-left; }
  Mod+Alt+Ctrl+j { move-column-to-workspace-down; }
  Mod+Alt+Ctrl+k { move-column-to-workspace-up; }
  Mod+Alt+Ctrl+l { move-column-right; }

  Mod+BracketLeft             { focus-column-left-or-last; }
  Mod+BracketRight            { focus-column-right-or-first; }
  Mod+Shift+BracketLeft       { move-column-to-first; }
  Mod+Shift+BracketRight      { move-column-to-last; }
  Mod+Ctrl+BracketLeft        { focus-column-first; }
  Mod+Ctrl+BracketRight       { focus-column-last; }

  Mod+Comma        { consume-window-into-column; }
  Mod+Period       { expel-window-from-column; }
  Mod+Shift+Comma  { spawn "/usr/bin/hollow-launch" "--label" "Previous media track" "--require" "playerctl" "--" "playerctl" "previous"; }
  Mod+Shift+Period { spawn "/usr/bin/hollow-launch" "--label" "Next media track" "--require" "playerctl" "--" "playerctl" "next"; }
  Mod+Alt+Comma    { center-column; }
  Mod+Alt+Period   { center-visible-columns; }

  Mod+Semicolon       { switch-focus-between-floating-and-tiling; }
  Mod+Shift+Semicolon { toggle-window-floating; }
  Mod+Ctrl+Semicolon  { focus-tiling; }
  Mod+Alt+Semicolon   { focus-floating; }

  // Change scope.
  Mod+Alt+Left  { focus-monitor-left; }
  Mod+Alt+Right { focus-monitor-right; }
  Mod+Alt+Down  { focus-workspace-down; }
  Mod+Alt+Up    { focus-workspace-up; }
  Mod+Alt+Ctrl+Shift+h { move-column-to-monitor-left; }
  Mod+Alt+Ctrl+Shift+j { move-column-to-workspace-down; }
  Mod+Alt+Ctrl+Shift+k { move-column-to-workspace-up; }
  Mod+Alt+Ctrl+Shift+l { move-column-to-monitor-right; }

  // Workspaces: focus.
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+0 { focus-workspace 10; }

  // Workspaces: send window and stay.
  Mod+Shift+1 { move-window-to-workspace 1 focus=false; }
  Mod+Shift+2 { move-window-to-workspace 2 focus=false; }
  Mod+Shift+3 { move-window-to-workspace 3 focus=false; }
  Mod+Shift+4 { move-window-to-workspace 4 focus=false; }
  Mod+Shift+5 { move-window-to-workspace 5 focus=false; }
  Mod+Shift+6 { move-window-to-workspace 6 focus=false; }
  Mod+Shift+7 { move-window-to-workspace 7 focus=false; }
  Mod+Shift+8 { move-window-to-workspace 8 focus=false; }
  Mod+Shift+9 { move-window-to-workspace 9 focus=false; }
  Mod+Shift+0 { move-window-to-workspace 10 focus=false; }

  // Workspaces: send column and stay.
  Mod+Ctrl+1 { move-column-to-workspace 1 focus=false; }
  Mod+Ctrl+2 { move-column-to-workspace 2 focus=false; }
  Mod+Ctrl+3 { move-column-to-workspace 3 focus=false; }
  Mod+Ctrl+4 { move-column-to-workspace 4 focus=false; }
  Mod+Ctrl+5 { move-column-to-workspace 5 focus=false; }
  Mod+Ctrl+6 { move-column-to-workspace 6 focus=false; }
  Mod+Ctrl+7 { move-column-to-workspace 7 focus=false; }
  Mod+Ctrl+8 { move-column-to-workspace 8 focus=false; }
  Mod+Ctrl+9 { move-column-to-workspace 9 focus=false; }
  Mod+Ctrl+0 { move-column-to-workspace 10 focus=false; }

  // Workspaces: send column and follow.
  Mod+Ctrl+Shift+1 { move-column-to-workspace 1; }
  Mod+Ctrl+Shift+2 { move-column-to-workspace 2; }
  Mod+Ctrl+Shift+3 { move-column-to-workspace 3; }
  Mod+Ctrl+Shift+4 { move-column-to-workspace 4; }
  Mod+Ctrl+Shift+5 { move-column-to-workspace 5; }
  Mod+Ctrl+Shift+6 { move-column-to-workspace 6; }
  Mod+Ctrl+Shift+7 { move-column-to-workspace 7; }
  Mod+Ctrl+Shift+8 { move-column-to-workspace 8; }
  Mod+Ctrl+Shift+9 { move-column-to-workspace 9; }
  Mod+Ctrl+Shift+0 { move-column-to-workspace 10; }

  // I — Images
  Mod+i hotkey-overlay-title="Images · Primary: imv" { spawn "/usr/bin/hollow-launch" "--label" "imv" "--require" "imv" "--" "imv"; }
  Mod+Shift+i hotkey-overlay-title="Images · Adjacent: Loupe" { spawn "/usr/bin/hollow-launch" "--label" "Loupe" "--require" "loupe" "--" "loupe"; }
  Mod+Ctrl+i hotkey-overlay-title="Images · Focused: Gwenview" { spawn "/usr/bin/hollow-launch" "--label" "Gwenview" "--require" "gwenview" "--" "gwenview"; }
  Mod+Alt+i hotkey-overlay-title="Images · Alternate: qView" { spawn "/usr/bin/hollow-launch" "--label" "qView" "--require" "qview" "--" "qview"; }

  // M — Music
  Mod+m hotkey-overlay-title="Music · Primary: AudioTube" { spawn "/usr/lib/hollow-grove/bin/audiotube-niri"; }
  Mod+Shift+m hotkey-overlay-title="Music · Adjacent: youtui" { spawn "/usr/bin/hollow-launch" "--label" "youtui" "--require" "kitty" "--require" "youtui" "--" "kitty" "youtui"; }
  Mod+Ctrl+m hotkey-overlay-title="Music · Focused: cmus" { spawn "/usr/bin/hollow-launch" "--label" "cmus" "--require" "kitty" "--require" "cmus" "--" "kitty" "cmus"; }
  Mod+Alt+m hotkey-overlay-title="Music · Alternate: Tauon Music Box" { spawn "/usr/bin/hollow-launch" "--label" "Tauon Music Box" "--require" "tauon" "--" "tauon"; }

  // N — News
  Mod+n hotkey-overlay-title="News · Primary: Newsboat" { spawn "/usr/bin/hollow-launch" "--label" "Newsboat" "--require" "kitty" "--require" "newsboat" "--" "kitty" "newsboat"; }
  Mod+Shift+n hotkey-overlay-title="News · Adjacent: Liferea" { spawn "/usr/bin/hollow-launch" "--label" "Liferea" "--require" "liferea" "--" "liferea"; }
  Mod+Ctrl+n hotkey-overlay-title="News · Focused: RSS Guard" { spawn "/usr/bin/hollow-launch" "--label" "RSS Guard" "--require" "rssguard" "--" "rssguard"; }
  Mod+Alt+n hotkey-overlay-title="News · Alternate: Fluent Reader" { spawn "/usr/bin/hollow-launch" "--label" "Fluent Reader" "--require" "fluent-reader" "--" "fluent-reader"; }

  // O — Office
  Mod+o hotkey-overlay-title="Office · Primary: LibreOffice Writer" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Writer" "--require" "libreoffice" "--" "libreoffice" "--writer"; }
  Mod+Shift+o hotkey-overlay-title="Office · Adjacent: LibreOffice Calc" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Calc" "--require" "libreoffice" "--" "libreoffice" "--calc"; }
  Mod+Ctrl+o hotkey-overlay-title="Office · Focused: LibreOffice Impress" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Impress" "--require" "libreoffice" "--" "libreoffice" "--impress"; }
  Mod+Alt+o hotkey-overlay-title="Office · Alternate: LibreOffice Draw" { spawn "/usr/bin/hollow-launch" "--label" "LibreOffice Draw" "--require" "libreoffice" "--" "libreoffice" "--draw"; }

  // P — Photos
  Mod+p hotkey-overlay-title="Photos · Primary: darktable" { spawn "/usr/bin/hollow-launch" "--label" "darktable" "--require" "darktable" "--" "darktable"; }
  Mod+Shift+p hotkey-overlay-title="Photos · Adjacent: RawTherapee" { spawn "/usr/bin/hollow-launch" "--label" "RawTherapee" "--require" "rawtherapee" "--" "rawtherapee"; }
  Mod+Ctrl+p hotkey-overlay-title="Photos · Focused: digiKam" { spawn "/usr/bin/hollow-launch" "--label" "digiKam" "--require" "digikam" "--" "digikam"; }
  Mod+Alt+p hotkey-overlay-title="Photos · Alternate: Shotwell" { spawn "/usr/bin/hollow-launch" "--label" "Shotwell" "--require" "shotwell" "--" "shotwell"; }

  // Q — Query
  Mod+q hotkey-overlay-title="Query · Primary: Gemini" { spawn "/usr/bin/hollow-launch" "--label" "Gemini CLI" "--require" "kitty" "--require" "gemini" "--" "kitty" "gemini"; }
  Mod+Shift+q hotkey-overlay-title="Query · Adjacent: Ollama" { spawn "/usr/bin/hollow-launch" "--label" "Ollama" "--require" "kitty" "--require" "ollama" "--" "kitty" "ollama" "launch"; }
  Mod+Ctrl+q hotkey-overlay-title="Query · Focused: AIChat" { spawn "/usr/bin/hollow-launch" "--label" "AIChat" "--require" "kitty" "--require" "aichat" "--" "kitty" "aichat"; }
  // Mod+Alt+q — Alternate: no additional general query environment is selected.

  // R — Record
  Mod+r hotkey-overlay-title="Record · Primary: Waveform" { spawn "/usr/bin/hollow-launch" "--label" "Tracktion Waveform" "--require" "Waveform13" "--" "Waveform13"; }
  Mod+Shift+r hotkey-overlay-title="Record · Adjacent: Ardour" { spawn "/usr/lib/hollow-grove/bin/ardour-niri"; }
  Mod+Ctrl+r hotkey-overlay-title="Record · Focused: Audacity" { spawn "/usr/bin/hollow-launch" "--label" "Audacity" "--require" "audacity" "--" "audacity"; }
  Mod+Alt+r hotkey-overlay-title="Record · Alternate: REAPER" { spawn "/usr/bin/hollow-launch" "--label" "REAPER" "--require" "reaper" "--" "reaper"; }

  // S — Settings
  Mod+s hotkey-overlay-title="Settings · Primary: Network TUI" { spawn "/usr/bin/hollow-launch" "--label" "NetworkManager TUI" "--require" "kitty" "--require" "nmtui" "--" "kitty" "nmtui"; }
  Mod+Shift+s hotkey-overlay-title="Settings · Adjacent: Blueman Manager" { spawn "/usr/bin/hollow-launch" "--label" "Blueman Manager" "--require" "blueman-manager" "--" "blueman-manager"; }
  Mod+Ctrl+s hotkey-overlay-title="Settings · Focused: Network Connections" { spawn "/usr/bin/hollow-launch" "--label" "Network Connections" "--require" "nm-connection-editor" "--" "nm-connection-editor"; }
  Mod+Alt+s hotkey-overlay-title="Settings · Alternate: PipeWire Volume" { spawn "/usr/bin/hollow-launch" "--label" "PipeWire Volume" "--require" "pwvucontrol" "--" "pwvucontrol"; }

  // T — Tasks
  Mod+t hotkey-overlay-title="Tasks · Primary: Taskwarrior TUI" { spawn "/usr/bin/hollow-launch" "--label" "Taskwarrior TUI" "--require" "kitty" "--require" "taskwarrior-tui" "--" "kitty" "taskwarrior-tui"; }
  Mod+Shift+t hotkey-overlay-title="Tasks · Adjacent: task next" { spawn "/usr/bin/hollow-launch" "--label" "Taskwarrior next" "--require" "kitty" "--require" "task" "--" "kitty" "--hold" "task" "next"; }
  Mod+Ctrl+t hotkey-overlay-title="Tasks · Focused: Planify" { spawn "/usr/bin/hollow-launch" "--label" "Planify" "--require" "planify" "--" "planify"; }
  Mod+Alt+t hotkey-overlay-title="Tasks · Alternate: task projects" { spawn "/usr/bin/hollow-launch" "--label" "Taskwarrior projects" "--require" "kitty" "--require" "task" "--" "kitty" "--hold" "task" "projects"; }

  // U — Utilities
  Mod+u hotkey-overlay-title="Utilities · Primary: btop" { spawn "/usr/bin/hollow-launch" "--label" "btop" "--require" "kitty" "--require" "btop" "--" "kitty" "btop"; }
  Mod+Shift+u hotkey-overlay-title="Utilities · Adjacent: ncdu" { spawn "/usr/bin/hollow-launch" "--label" "ncdu" "--require" "kitty" "--require" "ncdu" "--" "kitty" "ncdu"; }
  Mod+Ctrl+u hotkey-overlay-title="Utilities · Focused: nvtop" { spawn "/usr/bin/hollow-launch" "--label" "nvtop" "--require" "kitty" "--require" "nvtop" "--" "kitty" "nvtop"; }
  Mod+Alt+u hotkey-overlay-title="Utilities · Alternate: battop" { spawn "/usr/bin/hollow-launch" "--label" "battop" "--require" "kitty" "--require" "battop" "--" "kitty" "battop"; }

  // V — Video
  Mod+v hotkey-overlay-title="Video · Primary: FreeTube" { spawn "/usr/bin/hollow-launch" "--label" "FreeTube" "--require" "freetube" "--" "freetube"; }
  Mod+Shift+v hotkey-overlay-title="Video · Adjacent: VLC" { spawn "/usr/bin/hollow-launch" "--label" "VLC" "--require" "vlc" "--" "vlc"; }
  Mod+Ctrl+v hotkey-overlay-title="Video · Focused: mpv" { spawn "/usr/bin/hollow-launch" "--label" "mpv" "--require" "mpv" "--" "mpv"; }
  Mod+Alt+v hotkey-overlay-title="Video · Alternate: Haruna" { spawn "/usr/bin/hollow-launch" "--label" "Haruna" "--require" "haruna" "--" "haruna"; }

  // W — Write
  Mod+w hotkey-overlay-title="Write · Primary: Obsidian" { spawn "/usr/bin/hollow-launch" "--label" "Obsidian" "--require" "obsidian" "--" "obsidian"; }
  Mod+Shift+w hotkey-overlay-title="Write · Adjacent: Apostrophe" { spawn "/usr/bin/hollow-launch" "--label" "Apostrophe" "--require" "apostrophe" "--" "apostrophe"; }
  Mod+Ctrl+w hotkey-overlay-title="Write · Focused: Ghostwriter" { spawn "/usr/bin/hollow-launch" "--label" "Ghostwriter" "--require" "ghostwriter" "--" "ghostwriter"; }
  Mod+Alt+w hotkey-overlay-title="Write · Alternate: MarkText" { spawn "/usr/bin/hollow-launch" "--label" "MarkText" "--require" "marktext" "--" "marktext"; }

  // X — eXchange
  // Finance/markets has no selected portable fruit; all four branches stay empty.
  // Mod+x — Primary: unavailable.
  // Mod+Shift+x — Adjacent: unavailable.
  // Mod+Ctrl+x — Focused: unavailable.
  // Mod+Alt+x — Alternate: unavailable.

  // Y — sYnc
  Mod+y hotkey-overlay-title="sYnc · Primary: LocalSend" { spawn "/usr/bin/hollow-launch" "--label" "LocalSend" "--require" "localsend" "--" "localsend"; }
  Mod+Shift+y hotkey-overlay-title="sYnc · Adjacent: croc" { spawn "/usr/bin/hollow-launch" "--label" "croc" "--require" "kitty" "--require" "croc" "--" "kitty" "croc"; }
  Mod+Ctrl+y hotkey-overlay-title="sYnc · Focused: Magic Wormhole Receive" { spawn "/usr/bin/hollow-launch" "--label" "Magic Wormhole receive" "--require" "kitty" "--require" "wormhole-rs" "--" "kitty" "wormhole-rs" "receive"; }
  Mod+Alt+y hotkey-overlay-title="sYnc · Alternate: Magic Wormhole Send" { spawn "/usr/bin/hollow-launch" "--label" "Magic Wormhole send" "--require" "kitty" "--require" "wormhole-rs" "--" "kitty" "wormhole-rs" "send"; }

  // Z — Zip
  Mod+z hotkey-overlay-title="Zip · Primary: File Roller" { spawn "/usr/bin/hollow-launch" "--label" "File Roller" "--require" "file-roller" "--" "file-roller"; }
  Mod+Shift+z hotkey-overlay-title="Zip · Adjacent: Ark" { spawn "/usr/bin/hollow-launch" "--label" "Ark" "--require" "ark" "--" "ark"; }
  Mod+Ctrl+z hotkey-overlay-title="Zip · Focused: Xarchiver" { spawn "/usr/bin/hollow-launch" "--label" "Xarchiver" "--require" "xarchiver" "--" "xarchiver"; }
  Mod+Alt+z hotkey-overlay-title="Zip · Alternate: PeaZip" { spawn "/usr/bin/hollow-launch" "--label" "PeaZip" "--require" "peazip" "--" "peazip"; }

  Mod+Tab       { toggle-overview; }
  Mod+Shift+Tab { focus-window-previous; }
  Mod+Ctrl+Tab  { focus-workspace-previous; }
  Mod+Alt+Tab   { focus-monitor-previous; }

  // Glaüshouse / Space: clearance and usable window room. Height flow uses
  // the same four stages exposed directly on Alt+Shift+H/J/K/L.
  Mod+Space hotkey-overlay-title="Glaüshouse: Cycle Usable Room Forward" { switch-preset-column-width; }
  Mod+Shift+Space hotkey-overlay-title="Glaüshouse: Cycle Usable Room Backward" { switch-preset-column-width-back; }
  Mod+Ctrl+Space               { set-column-width "25%"; }
  Mod+Ctrl+Shift+Space repeat=false hotkey-overlay-title="Glaüshouse: Flow Height Up · Next 25/50/75/100% Stage" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "up"; }
  Mod+Alt+Space                { expand-column-to-available-width; }
  Mod+Alt+Ctrl+Space           { toggle-windowed-fullscreen; }
  // Sandmanor / Backspace: returning threshold and revision.
  Mod+Alt+BackSpace            { spawn "/usr/bin/hollow-hueman" "clear"; }
  Mod+Alt+Shift+Space repeat=false hotkey-overlay-title="Glaüshouse: Flow Height Down · Next 25/50/75/100% Stage" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-flow" "down"; }
  Mod+Ctrl+Alt+BackSpace       { reset-window-height; }
  Mod+Ctrl+Alt+Shift+Space repeat=false hotkey-overlay-title="Glaüshouse: Focus 75% / Bookmark 25%" { spawn "/usr/lib/hollow-grove/bin/hollow-niri" "height-cycle"; }

  Mod+Minus       { set-dynamic-cast-window; }
  Mod+Equal       { set-dynamic-cast-monitor; }
  Mod+Shift+Minus { clear-dynamic-cast-target; }
  Mod+Shift+Equal { spawn "/usr/bin/hollow-launch" "--label" "OBS Studio" "--require" "obs" "--" "obs"; }
  Mod+Ctrl+Minus  { spawn "/usr/lib/hollow-grove/bin/screenshot-copy" "region"; }
  Mod+Ctrl+Equal  { spawn "/usr/lib/hollow-grove/bin/screenshot-copy" "screen"; }

  XF86AudioRaiseVolume allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "raise"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "lower"; }
  XF86AudioMute        allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "mute"; }
  XF86AudioMicMute     allow-when-locked=true { spawn "/usr/lib/hollow-grove/bin/volume-control" "mic-mute"; }

  XF86MonBrightnessUp   { spawn "/usr/lib/hollow-grove/bin/brightness-control" "raise"; }
  XF86MonBrightnessDown { spawn "/usr/lib/hollow-grove/bin/brightness-control" "lower"; }

  Print { screenshot; }
}
