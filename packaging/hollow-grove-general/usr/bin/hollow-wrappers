#!/usr/bin/env python3
"""Windows compatibility hub, executable picker, bottle settings, and Proton tools."""

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

APP_ID = "com.usebottles.bottles"


def require(command):
    if not shutil.which(command):
        raise RuntimeError(f"Install {command} to use this Wrappers route.")


def backend():
    if shutil.which("flatpak"):
        result = subprocess.run(["flatpak", "info", APP_ID],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            return "flatpak"
    if shutil.which("bottles"):
        return "native"
    raise RuntimeError("Install Bottles: flatpak install --user flathub com.usebottles.bottles")


def command(kind, cli=False):
    if kind == "flatpak":
        return ["flatpak", "run"] + (["--command=bottles-cli"] if cli else []) + [APP_ID]
    name = "bottles-cli" if cli else "bottles"
    require(name)
    return [name]


def focus_hub():
    if not os.environ.get("NIRI_SOCKET") or not shutil.which("niri"):
        return False
    result = subprocess.run(["niri", "msg", "--json", "windows"], capture_output=True, text=True)
    if result.returncode:
        return False
    for window in json.loads(result.stdout):
        if (window.get("app_id") or "").lower() in (APP_ID, "bottles"):
            subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(window["id"])], check=True)
            return True
    return False


def hub(kind):
    if not focus_hub():
        argv = command(kind)
        os.execvp(argv[0], argv)


def dialog(*args):
    require("zenity")
    result = subprocess.run(["zenity", *args], capture_output=True, text=True)
    if result.returncode == 1:  # Cancel/close
        return None
    if result.returncode:
        raise RuntimeError("The Wrappers dialog could not open.")
    return result.stdout.removesuffix("\n")


def bottle_names(kind):
    result = subprocess.run(command(kind, cli=True) + ["--json", "list", "bottles"],
                            capture_output=True, text=True)
    if result.returncode:
        # Bottles' CLI cannot list a fresh profile before the GUI creates its directories.
        if "FileNotFoundError" in result.stderr:
            return []
        raise RuntimeError("Bottles could not list its environments. Open Mod+W to finish its setup.")
    data = json.loads(result.stdout)
    if not isinstance(data, dict):
        raise RuntimeError("Bottles returned an unsupported environment list.")
    names = []
    for key, config in data.items():
        if isinstance(config, dict) and config.get("Environment") == "Steam":
            continue  # Steam compatibility settings belong to the Protontricks route.
        name = config.get("Name", key) if isinstance(config, dict) else key
        if isinstance(name, str) and name:
            names.append(name)
    return sorted(set(names), key=str.casefold)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("hub", "run", "configure", "proton"))
    args = parser.parse_args()
    if args.mode == "proton":
        require("protontricks")
        if not (shutil.which("yad") or shutil.which("zenity")):
            raise RuntimeError("Install yad or zenity for the Protontricks game picker.")
        os.execvp("protontricks", ["protontricks", "--no-term", "--gui"])
    kind = backend()
    if args.mode == "hub":
        hub(kind)
        return
    if args.mode == "run":
        filename = dialog("--file-selection", "--title=Wrappers · Run Windows Software",
                          "--file-filter=Windows software | *.exe *.msi *.EXE *.MSI",
                          "--file-filter=All files | *")
        if filename is None:
            return
        selected = Path(filename).absolute()
        if not selected.is_file() or selected.suffix.lower() not in (".exe", ".msi"):
            raise RuntimeError("Choose an existing .exe or .msi file.")
        # Flatpak forwards this selected file through its document portal. No home-wide override.
        argv = (["flatpak", "run", "--file-forwarding", APP_ID, "--executable", "@@", str(selected), "@@"]
                if kind == "flatpak" else command(kind) + ["--executable", str(selected)])
        os.execvp(argv[0], argv)
    names = bottle_names(kind)
    if not names:
        if dialog("--info", "--title=Wrappers · Bottle Settings",
                  "--text=Finish Bottles setup and create your first bottle. Ctrl+W will then let you select it and open its Windows configuration.") is not None:
            hub(kind)
        return
    # Numeric hidden IDs preserve names containing markup, tabs, newlines, or shell syntax.
    rows = []
    for index, name in enumerate(names):
        label = "".join(c if c.isprintable() else " " for c in name)
        rows.extend([str(index), label])
    selected = dialog("--list", "--title=Wrappers · Configure a Bottle", "--height=420", "--width=520",
                      "--column=ID", "--column=Bottle", "--hide-column=1", "--print-column=1",
                      "--no-markup", *rows)
    if selected is None:
        return
    try:
        index = int(selected)
    except ValueError as error:
        raise RuntimeError("Invalid bottle selection.") from error
    if not 0 <= index < len(names):
        raise RuntimeError("Invalid bottle selection.")
    argv = command(kind, cli=True) + ["tools", "-b", names[index], "winecfg"]
    os.execvp(argv[0], argv)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"hollow-wrappers: {error}", file=sys.stderr)
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "Wrappers", str(error)])
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(0)
