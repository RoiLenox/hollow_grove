#!/usr/bin/bash
set -u

command -v brightnessctl >/dev/null 2>&1 || exit 0
command -v notify-send >/dev/null 2>&1 || exit 0

current=$(brightnessctl get 2>/dev/null) || exit 0
maximum=$(brightnessctl max 2>/dev/null) || exit 0
(( maximum > 0 )) || exit 0
percent=$((current * 100 / maximum))
filled=$((percent / 5))
bar=

for ((index = 1; index <= 20; index++)); do
    if (( index <= filled )); then
        bar+="█"
    else
        bar+="░"
    fi
done

notify-send \
    --app-name="brightness-osd" \
    --expire-time=1800 \
    --replace-id=41002 \
    "Brightness ${percent}%" "$bar" >/dev/null 2>&1 || true
