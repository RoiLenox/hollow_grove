#!/usr/bin/bash
set -u

if ! command -v lmms >/dev/null 2>&1; then
    /usr/lib/hollow-grove/bin/notify \
        "LMMS unavailable" \
        "Install LMMS and XWayland support to use this optional studio binding." \
        normal
    exit 127
fi

export QT_QPA_PLATFORM=xcb
export SDL_VIDEODRIVER=x11
export RESOURCE_NAME=lmms

exec -a lmms lmms "$@"
