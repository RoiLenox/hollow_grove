#!/usr/bin/bash
set -u

for locker_process in swaylock hyprlock gtklock; do
    if pgrep -x "$locker_process" >/dev/null 2>&1; then
        exit 0
    fi
done

if command -v swaylock >/dev/null 2>&1; then
    exec swaylock --color 101218 --indicator --clock --show-failed-attempts
fi

if command -v hyprlock >/dev/null 2>&1; then
    exec hyprlock
fi

if command -v gtklock >/dev/null 2>&1; then
    exec gtklock
fi

if command -v loginctl >/dev/null 2>&1 && loginctl lock-session >/dev/null 2>&1; then
    exit 0
fi

/usr/lib/hollow-grove/bin/notify \
    "Screen lock unavailable" \
    "Install swaylock before relying on session locking." \
    critical
exit 1
