pkgname=hollow-grove-core
pkgver=0.1.0
pkgrel=1
pkgdesc='Authoritative Hollow Grove gameplay service and Hueman integration seam'
arch=('x86_64' 'aarch64')
url='https://github.com/RoiLenox/hollow_grove'
license=('LicenseRef-Hollow-Grove-Proprietary')
options=('!debug')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('hueman: independent Godot presentation client')
source=()
sha256sums=()

build() {
    local repository_root="$startdir/../.."
    cd "$repository_root"
    cargo build --release --locked --offline --bin hollow_grove_game_service
}

check() {
    local repository_root="$startdir/../.."
    cd "$repository_root"
    cargo test --locked --offline --test gameplay_protocol
}

package() {
    local repository_root="$startdir/../.."
    install -Dm755 "$repository_root/target/release/hollow_grove_game_service" \
        "$pkgdir/usr/lib/hollow-grove/core/hollow_grove_game_service"
    install -Dm755 "$startdir/hollow-grove-service" \
        "$pkgdir/usr/bin/hollow-grove-service"
    install -Dm755 "$startdir/hollow-grove-with-hueman" \
        "$pkgdir/usr/bin/hollow-grove-with-hueman"
    ln -s hollow-grove-with-hueman "$pkgdir/usr/bin/hollow-grove-hueman"
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$repository_root/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
