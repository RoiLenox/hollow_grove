#!/usr/bin/env bash

set -euo pipefail

launcher_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
install_prefix="$(cd -- "$launcher_dir/../../.." && pwd)"
service_bin="$launcher_dir/hollow_grove_game_service"
game_pack="$install_prefix/share/hollow-grove-hueman/hollow-grove-hueman.pck"
godot_bin="${GODOT_BIN:-}"
service_pid=""

if [[ -z "$godot_bin" ]]; then
    if command -v godot4 >/dev/null 2>&1; then
        godot_bin="$(command -v godot4)"
    elif command -v godot >/dev/null 2>&1; then
        godot_bin="$(command -v godot)"
    else
        printf 'Hollow Grove Hueman requires Godot 4.7 or newer.\n' >&2
        exit 127
    fi
fi

if [[ ! -x "$service_bin" ]]; then
    printf 'missing authoritative gameplay service: %s\n' "$service_bin" >&2
    exit 1
fi
if [[ ! -f "$game_pack" ]]; then
    printf 'missing Hueman game pack: %s\n' "$game_pack" >&2
    exit 1
fi

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/hollow-grove"
data_root="${XDG_DATA_HOME:-$HOME/.local/share}/hollow-grove"
save_root="$data_root/gameplay-saves"
world_root="$data_root/world"
mkdir -p -- "$state_root" "$save_root" "$world_root"
chmod 700 -- "$state_root" "$save_root"

cleanup() {
    if [[ -n "$service_pid" ]]; then
        kill "$service_pid" 2>/dev/null || true
        wait "$service_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

"$service_bin" \
    --listen 127.0.0.1:47819 \
    --session session.hollow-grove.local \
    --save-root "$save_root" \
    --world-root "$world_root" &
service_pid="$!"

export HOLLOW_GROVE_STATE_HOME="$state_root"
export HOLLOW_GROVE_DATA_HOME="$data_root"
"$godot_bin" --main-pack "$game_pack" "$@"
